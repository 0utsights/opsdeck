{
  "refresh_seconds": 3,
  "agents_dir": "~/.local/state/opsdeck/agents",
  "workflows_file": "~/.local/state/opsdeck/workflows.json",
  "servers": [
    {
      "id": "local",
      "name": "LOCAL HOST",
      "kind": "local"
    },
    {
      "id": "remote-vps",
      "name": "REMOTE VPS",
      "kind": "ssh",
      "address": "server.example.com",
      "user": "ubuntu",
      "identity_file": "~/.ssh/opsdeck_probe",
      "probe_path": "/usr/local/bin/opsdeck",
      "sudo": true
    }
  ],
  "sites": [
    {
      "id": "example-site",
      "name": "EXAMPLE SITE",
      "url": "https://example.com/health",
      "container_patterns": ["example-web", "example-api"]
    }
  ],
  "migrations": [
    {
      "site_id": "example-site",
      "from_server": "local",
      "to_server": "remote-vps"
    }
  ]
}
